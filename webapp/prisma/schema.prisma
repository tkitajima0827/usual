// 予実管理ソフト - データモデル（MVP: 単一顧客の単年度PL計画）
// 詳しくは README.md の設計メモを参照

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  FIRM_ADMIN // 事務所側 管理者
  FIRM_STAFF // 事務所側 担当者
  CLIENT_ADMIN // 顧客側 管理者
  CLIENT_USER // 顧客側 利用者
}

enum TaxAccountingMethod {
  INCLUSIVE // 税込経理
  EXCLUSIVE // 税抜経理
}

enum Statement {
  PL
  BS
  CF
}

enum PLCategory {
  REVENUE // 売上高
  COGS // 売上原価
  SGA // 販売費及び一般管理費
  NON_OPERATING_INCOME // 営業外収益
  NON_OPERATING_EXPENSE // 営業外費用
  EXTRAORDINARY_INCOME // 特別利益
  EXTRAORDINARY_LOSS // 特別損失
  INCOME_TAXES // 法人税等
}

enum CalcMethod {
  PREV_YEAR_SAME // 前年同額
  LINKED // 科目連動
  DIRECT // 直接入力
  PAST_AVERAGE // 過去平均（該当月の前12ヶ月平均）
}

enum ConsumptionTaxCategory {
  TAXABLE // 課税
  EXEMPT // 非課税
  OUT_OF_SCOPE // 不課税・対象外（給与・租税公課・法人税等など）
}

enum SettlementDirection {
  RECEIVABLE // 売掛金（回収）
  PAYABLE // 買掛金（支払）
}

model Client {
  id                   String              @id @default(cuid())
  name                 String
  fiscalYearStartMonth Int                 @default(4) // 期首月 (1-12)
  taxMethod            TaxAccountingMethod @default(EXCLUSIVE)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  users          User[]
  accounts       Account[]
  fiscalYears    FiscalYear[]
  monthlyActuals MonthlyActual[]
  settlementTerms DefaultSettlementTerm[]
  counterparties  Counterparty[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         UserRole
  passwordHash String // bcryptハッシュ。ログイン画面からのメール+パスワード認証に使う
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([clientId])
}

model Account {
  id                     String                  @id @default(cuid())
  clientId               String
  client                 Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code                   String
  name                   String
  statement              Statement               @default(PL)
  plCategory             PLCategory?
  sortOrder              Int                     @default(0)
  isActive               Boolean                 @default(true)
  // 消費税の概算計算（本則課税）に使う課税区分。既定値は科目名からの
  // 自動推定（src/lib/tax配下）で設定し、必要に応じて手動で上書きする。
  consumptionTaxCategory ConsumptionTaxCategory  @default(TAXABLE)

  // 回収・支払サイトの科目ごとの個別設定（3項目すべて設定されている場合のみ、
  // 事業者共通の既定サイト(DefaultSettlementTerm)より優先して使う）。
  settlementClosingDay    Int? // 締め日 (1-31、31は月末扱い)
  settlementMonthsAfter   Int? // 何ヶ月後に回収/支払するか（翌月=1、翌々月=2 ...）
  settlementDay           Int? // 回収/支払日 (1-31、31は月末扱い)

  monthlyActuals  MonthlyActual[]
  planEntries     PlanEntry[]     @relation("AccountPlanEntry")
  linkedByEntries PlanEntry[]     @relation("LinkedAccount")
  counterparties  Counterparty[]

  @@unique([clientId, code])
  @@index([clientId])
}

// 事業者ごとの既定の回収・支払サイト（例:「末締め翌月末」）。
// 売上高科目（REVENUE）は回収(RECEIVABLE)、売上原価科目（COGS）は支払(PAYABLE)に
// この既定値を適用する。科目ごとの個別設定があればそちらを優先する。
model DefaultSettlementTerm {
  id            String              @id @default(cuid())
  clientId      String
  client        Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  direction     SettlementDirection
  closingDay    Int                 @default(31) // 締め日 (1-31、31は月末扱い)
  monthsAfter   Int                 @default(1) // 翌月=1、翌々月=2 ...
  settlementDay Int                 @default(31) // 回収/支払日 (1-31、31は月末扱い)
  updatedAt     DateTime            @updatedAt

  @@unique([clientId, direction])
}

// 相手先（得意先・仕入先）マスタ。標準の締め日・回収/支払サイトに当てはまらない
// 相手先のみ、個別のサイトを登録する運用を想定（bixidの相手先マスタに相当）。
// 現状のデータモデルには相手先別の取引実績が無いため、月次入出金予定の計算には
// まだ組み込んでおらず、登録・参照のみ可能（将来、相手先別の実績取込に対応した際に連動させる）。
model Counterparty {
  id            String              @id @default(cuid())
  clientId      String
  client        Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accountId     String?
  account       Account?            @relation(fields: [accountId], references: [id])
  name          String
  direction     SettlementDirection
  closingDay    Int                 @default(31)
  monthsAfter   Int                 @default(1)
  settlementDay Int                 @default(31)
  createdAt     DateTime            @default(now())

  @@unique([clientId, name, direction])
  @@index([clientId])
}

model MonthlyActual {
  id        String  @id @default(cuid())
  clientId  String
  client    Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accountId String
  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  year      Int
  month     Int // 1-12 (暦月)
  amount    Decimal @db.Decimal(14, 2)

  @@unique([accountId, year, month])
  @@index([clientId, year, month])
}

model FiscalYear {
  id         String @id @default(cuid())
  clientId   String
  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label      String // 例: 2026年度
  startYear  Int
  startMonth Int // 期首月 (1-12)

  planEntries PlanEntry[]
  taxSettings TaxSettings?

  @@unique([clientId, startYear, startMonth])
  @@index([clientId])
}

// 消費税・法人税の概算計算に使う設定。前期の申告実績（中間納付額の算出根拠）と
// 実効税率・繰越欠損金・消費税率を会計年度ごとに保持する（bixidの「申告データ登録」に相当、
// 概算計算のため個別税目には分解せず単純化している）。
model TaxSettings {
  id           String     @id @default(cuid())
  fiscalYearId String     @unique
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)

  effectiveTaxRate Decimal @db.Decimal(5, 2) @default(33.00) // 法人税等の実効税率(%)概算値
  lossCarryforward Decimal @db.Decimal(14, 2) @default(0) // 当期に控除できる繰越欠損金

  consumptionTaxRate Decimal @db.Decimal(5, 2) @default(10.00) // 消費税率(%)

  // 前期の年間納付額（中間納付額の概算＝前期実績の1/2、に使用）
  priorYearCorporateTaxAnnual  Decimal? @db.Decimal(14, 2)
  priorYearConsumptionTaxAnnual Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlanEntry {
  id               String     @id @default(cuid())
  fiscalYearId     String
  fiscalYear       FiscalYear @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  accountId        String
  account          Account    @relation("AccountPlanEntry", fields: [accountId], references: [id], onDelete: Cascade)
  calcMethod       CalcMethod
  linkedAccountId  String?
  linkedAccount    Account?   @relation("LinkedAccount", fields: [linkedAccountId], references: [id])
  linkedPercentage Decimal?   @db.Decimal(7, 4) // 例: 60.5000 (%)

  directValues PlanDirectValue[]

  @@unique([fiscalYearId, accountId])
  @@index([linkedAccountId])
}

model PlanDirectValue {
  id          String    @id @default(cuid())
  planEntryId String
  planEntry   PlanEntry @relation(fields: [planEntryId], references: [id], onDelete: Cascade)
  year        Int
  month       Int // 1-12 (暦月)
  amount      Decimal   @db.Decimal(14, 2)

  @@unique([planEntryId, year, month])
}
