DATABASE_URL="postgresql://user:password@localhost:5432/webapp?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-generated-secret"

# Used only by `npm run start` (production boot) to seed the first admin
# account. See README.md "本番環境へのデプロイ" for the Railway setup.
# SEED_ADMIN_EMAIL="you@example.com"
# SEED_ADMIN_PASSWORD="change-me-please"

# Optional: enables "残高証明書をアップロードして自動入力（AI）" on the
# opening-balance page (Claude's vision API reads the uploaded PDF/image).
# Get a key at https://console.anthropic.com/ . Without this variable the
# rest of the app works normally; only the AI upload button shows an error.
# ANTHROPIC_API_KEY="sk-ant-..."
